# Clé secrète Flask — obligatoire au démarrage.
# Générez une valeur avec :
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# URL du webhook Power Automate pour le formulaire de contact.
webhook=

# URL Microsoft Bookings (optionnel).
BOOKINGS_URL=

# Passe "true" pour activer le mode debug Flask (dev uniquement).
FLASK_DEBUG=false
